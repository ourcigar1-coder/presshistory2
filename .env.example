# Sanity Content Lake
# https://www.sanity.io/manage 에서 프로젝트 생성 후 값을 채운다
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
# Draft/preview 조회용 read 토큰 (Viewer 권한으로 충분)
SANITY_API_READ_TOKEN=
# Sanity webhook 재검증 시크릿
SANITY_REVALIDATE_SECRET=

# PostHog (06 Analytics) — 선택사항. 가족용 비공개 서비스에서는 생략 가능.
# 키가 없으면 분석 이벤트가 전송되지 않으며(코드상 안전하게 비활성), 사이트 동작에는 영향 없음.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
